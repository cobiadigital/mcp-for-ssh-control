# Copy to .env in this directory (it is gitignored, so `git pull` never
# touches it) and fill in. The service refuses to start without the two
# ACCESS_* values.

# --- Identity -------------------------------------------------------------
# Short name for this box, used to label its log lines and server_info
# output. Purely cosmetic — it does not affect how Claude addresses the
# tools. That is the Server ID you set on the Cloudflare side when you
# register the box; conventionally the same word, so logs and tool names
# agree.
SERVER_ID=lightsail

# --- Auth -----------------------------------------------------------------
# The Cloudflare Access service token this server accepts. Create it under
# Zero Trust > Access controls > Service credentials, and give the same pair
# to the MCP portal as this server's auth headers.
ACCESS_CLIENT_ID=REPLACE_ME.access
ACCESS_CLIENT_SECRET=REPLACE_ME

# --- Allowlists -----------------------------------------------------------
# The exact Docker container names the tools may name, comma-separated.
# Get them with: docker ps --format '{{.Names}}' | paste -sd, -
#
# Set to a lone * to allow every container on the box, including ones created
# after the service starts. That is a convenience, not a hole: the tools that
# take a container name are still only docker_ps, docker_logs and
# docker_restart, so * widens which containers can be inspected and
# restarted, never what can be done to them. Prefer an explicit list on a box
# that runs containers belonging to someone else.
ALLOWED_CONTAINERS=wordpress,wordpress-db,odoo,odoo-db

# Systemd units the tools may query. Defaults to nginx,docker,cloudflared.
# Also accepts a lone * for every unit on the box; service_status is
# read-only, so the only exposure is being able to read any unit's status.
ALLOWED_SERVICES=nginx,docker,cloudflared

# Absolute directory roots the file and script tools may touch, comma-separated.
# Leave unset to disable all six file/script tools.
#
# Read this before setting it: write access plus run access inside the same
# root is code execution as the service user. Only list directories you are
# comfortable with a model editing and executing in.
ALLOWED_PATHS=/home/ubuntu/scripts

# --- Networking -----------------------------------------------------------
# Loopback port the Cloudflare Tunnel forwards to. The bind address is always
# 127.0.0.1 and is not configurable.
PORT=8787
